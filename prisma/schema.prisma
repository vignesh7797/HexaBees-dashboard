generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}



model menu_hexa {
  id       Int             @id @default(autoincrement())
  name     String
  code     String
  type     String
  varient  String
  category String
  image    String?
  price    Float
  billing  billing_hexa[]
}

model order_hexa {
  id           Int             @id @default(autoincrement())
  date         DateTime
  customer_name String
  sub_total    Float
  discount     Float
  total_amount Float
  billing      billing_hexa[]
}

model billing_hexa {
  id       Int         @id @default(autoincrement())
  menu_id  Int
  order_id Int
  quantity Int
  price    Float

  menu     menu_hexa   @relation(fields: [menu_id], references: [id])
  order    order_hexa  @relation(fields: [order_id], references: [id])
}